<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    tools:context=".MainActivity"
    android:padding="16dp"> <TextView
    android:id="@+id/textViewStatus"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Vez de X"
    android:textSize="32sp"
    android:textStyle="bold"
    android:textColor="@android:color/black"
    android:padding="16dp"
    android:layout_marginBottom="20dp"/> <GridLayout
    android:id="@+id/gridLayoutBoard"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:columnCount="3"
    android:rowCount="3"
    android:background="@android:color/black"
    android:padding="2dp">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button00"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button01"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button02"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button10"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button11"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button12"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button20"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button21"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button22"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_margin="2dp"
        android:textSize="60sp"
        android:textStyle="bold"
        android:backgroundTint="@color/board_button_background" />

</GridLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/buttonReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reiniciar Jogo"
        android:textSize="20sp"
        android:layout_marginTop="30dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

</LinearLayout>